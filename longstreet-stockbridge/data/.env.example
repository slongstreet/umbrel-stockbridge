# Stockbridge configuration on umbrelOS.
# Copy to .env in this same folder (app-data/longstreet-stockbridge/data/) and
# fill in real values, then restart the app from the Umbrel dashboard.
# The backend reads it as its working-directory .env, exactly like
# backend/.env in development.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-to-a-random-32-char-string

# ── Frontend origin (used for CORS and the post-OAuth redirect) ──────────────
# The canonical HTTPS origin you browse the app at, e.g. the Tailscale name:
# https://umbrel-2.<tailnet>.ts.net
FRONTEND_URL=

# ── eBay — Production ────────────────────────────────────────────────────────
EBAY_PROD_CLIENT_ID=
EBAY_PROD_CLIENT_SECRET=
EBAY_PROD_RUNAME=
EBAY_ENVIRONMENT=production

# Must be registered against the RuName in the eBay developer console.
# e.g. https://umbrel-2.<tailnet>.ts.net/api/ebay/callback
EBAY_OAUTH_CALLBACK_URL=

# ── LLM backends ─────────────────────────────────────────────────────────────
LLM_BACKEND=anthropic          # anthropic | openai | ollama | lmstudio
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama / LM Studio running on another machine, use its LAN/tailnet
# address — "localhost" here is the container, not your Mac.
OLLAMA_BASE_URL=
LMSTUDIO_BASE_URL=

# ── Sync ─────────────────────────────────────────────────────────────────────
# Hours between automatic eBay syncs. Set to 0 for manual-only.
SYNC_INTERVAL_HOURS=4
