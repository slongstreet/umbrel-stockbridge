# Copy to .env in this folder (the app reads it from /data). Every value has a default.
APP_ENV=production
DATABASE_URL=sqlite:///./mogprice.db
MIGRATE_ON_STARTUP=true
SQL_ECHO=false
# Unknown barcodes are looked up for a hint (only the code is sent). "off"
# never calls out. Without a key, UPCitemdb's free tier: 100 lookups a day.
BARCODE_PROVIDER=upcitemdb
UPCITEMDB_KEY=
BARCODE_DAILY_LIMIT=100
BARCODE_HINT_DAYS=30
# The language-model pass over unmatched rows (comps model-pass). "ollama"
# calls a local Ollama; only listing titles and candidate products are sent.
# Answers wait in the review queue unless MODEL_AUTO_ACCEPT is on.
MODEL_PROVIDER=off
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
MODEL_AUTO_ACCEPT=false
MODEL_ACCEPT=0.9
MODEL_TIMEOUT=180
# Uploads over 5,000 rows wait in UPLOAD_DIR for the worker; proof files live
# in PROOF_DIR and are never served. Both are inside /data in Docker.
MAX_UPLOAD_BYTES=67108864
UPLOAD_DIR=uploads
PROOF_DIR=proofs
PROOF_MAX_BYTES=10485760
# The in-process worker for queued batches; off, run `python -m app.cli worker run`.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
